EXPERIMENT_LABEL=
# Override opsional (kosongkan untuk memakai default dari mode):
# MAX_GENERATE_RETRIES=2
# MAX_UPLOAD_RETRIES=1
# RETRY_BASE_DELAY_MS=2000
# UPLOAD_TIMEOUT_MS=300000
# GENERATE_TIMEOUT_MS=240000
# ACTIVE_POLL_INITIAL_MS=1000
# ACTIVE_POLL_MAX_MS=5000
# ACTIVE_POLL_BACKOFF=1.5
# ACTIVE_TIMEOUT_MS=600000
# FAIL_FAST=true
# PROCESSING_DEADLINE_MS=900000
# STALE_SWEEP_INTERVAL_MS=60000
# REUSE_GEMINI_FILE_FOR_QNA=true
# INLINE_VIDEO_MAX_MB=0
# Fault injection untuk uji ketahanan (0..1):
# FAULT_GENERATE_ERROR_RATE=0
# FAULT_GENERATE_HANG_RATE=0
# FAULT_HANG_MS=600000
